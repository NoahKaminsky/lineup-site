# Copy this file to .env.local for development.
# For production, set the same variable names in Vercel (Project Settings -> Environment Variables)
# using LIVE values instead of test values. No code changes are needed to go live —
# just swap the values below for their live-mode equivalents.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Must be the real production domain in production (used in email links, Stripe redirect URLs, etc.)
NEXT_PUBLIC_SITE_URL=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NEWSLETTER_KEY=

# --- Google ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Cron ---
# Vercel automatically sends this as a Bearer token to scheduled routes (e.g. /api/reminders)
# when this env var is set on the project. Generate any random string.
CRON_SECRET=

# --- Stripe (core) ---
# In test mode use sk_test_/pk_test_ keys. In live mode, switch to sk_live_/pk_live_ keys
# generated from the Stripe Dashboard with "Test mode" toggled OFF.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# This is generated per-webhook-endpoint in the Stripe Dashboard (Developers -> Webhooks).
# Test mode and live mode each need their OWN webhook endpoint configured in Stripe,
# each with its own signing secret — you cannot reuse the test secret in live mode.
STRIPE_WEBHOOK_SECRET=

# --- Stripe Subscriptions (price IDs) ---
# Create these as actual Products/Prices in the Stripe Dashboard (test mode AND live mode
# each need their own copies created separately — price IDs differ between modes).
# NOTE: must be NEXT_PUBLIC_ prefixed — both the client (checkout) and the webhook
# (plan detection on subscription events) read these exact names.
NEXT_PUBLIC_STRIPE_APPRENTICE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_MASTER_PRICE_ID=
